---
// Hidden on-device benchmark (not linked from the main page, noindex).
// See src/scripts/bench.ts. No web fonts or other third-party requests: the only
// download is the model itself.
import model from "../../data/model.json";
import bench from "../../data/bench_orders.json";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const timed = bench.orders.length - bench.warmup;
const mb = Math.round(model.bytes / 1e6);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline src={`${base}coi-serviceworker.min.js`}></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Device bench</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <style>
      :root {
        --bg: #faf7f2; --card: #ffffff; --ink: #2a2420; --muted: #7d736a; --rule: #e4ddd2;
        --accent: #8a4fd0; --green: #2f9460; --red: #d8432b; --amber: #c98d00;
        color-scheme: light dark;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #1d1916; --card: #27221e; --ink: #f2ece2; --muted: #a39789; --rule: #3a332d; --accent: #b689f0; }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      }
      main { max-width: 640px; margin: 0 auto; padding: 28px 16px 48px; }
      h1 { font-size: 1.6rem; line-height: 1.2; margin: 0 0 6px; letter-spacing: -0.01em; }
      p { margin: 0 0 12px; }
      .muted { color: var(--muted); font-size: 0.9rem; }
      .card { background: var(--card); border: 1px solid var(--rule); border-radius: 14px; padding: 16px; margin: 16px 0; }
      label { display: block; font-size: 0.85rem; color: var(--muted); margin-bottom: 4px; }
      input {
        width: 100%; font: inherit; padding: 10px 12px; border-radius: 10px;
        border: 1px solid var(--rule); background: var(--bg); color: var(--ink);
      }
      .row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
      button {
        font: inherit; font-weight: 600; padding: 10px 16px; border-radius: 10px; cursor: pointer;
        border: 1px solid var(--rule); background: var(--card); color: var(--ink);
      }
      button.primary { background: var(--accent); border-color: var(--accent); color: #fff; flex: 1; min-width: 160px; }
      button:disabled { opacity: 0.5; cursor: default; }
      .bar { height: 6px; border-radius: 3px; background: var(--rule); overflow: hidden; margin-top: 12px; }
      .bar i { display: block; height: 100%; width: calc(var(--p, 0) * 100%); background: var(--accent); transition: width 0.2s; }
      #b-status { margin-top: 8px; font-variant-numeric: tabular-nums; }
      pre#b-ticket {
        margin: 8px 0 0; min-height: 2.4em; white-space: pre-wrap; font: 0.85rem/1.4 ui-monospace, Menlo, monospace;
        color: var(--muted);
      }
      .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .stat { background: var(--bg); border-radius: 10px; padding: 10px 12px; }
      .stat b { display: block; font-size: 1.35rem; font-variant-numeric: tabular-nums; }
      .stat span { font-size: 0.8rem; color: var(--muted); }
      .warn { color: var(--red); font-size: 0.9rem; }
      footer { font-size: 0.8rem; color: var(--muted); margin-top: 24px; }
      footer a { color: inherit; }
    </style>
  </head>
  <body>
    <main>
      <h1>Device bench</h1>
      <p class="muted">
        Runs the real model in this tab on {timed} fixed PIZZA test orders (after
        {bench.warmup} warm-up orders), and times each one from submit to printed
        ticket. Nothing is uploaded. When it finishes, download the result and send
        the file to the authors.
      </p>

      <div class="card">
        <label for="b-label">Device and browser (goes into the file name)</label>
        <input id="b-label" placeholder="e.g. Pixel 8, Chrome 131" autocomplete="off" />
        <p class="muted" id="b-dev" style="margin-top:8px"></p>
        <p class="warn" id="b-insecure" hidden>
          This page is not a secure context (it needs HTTPS, or localhost). The model
          cannot be cached and runs on one thread, so these numbers do not represent
          the live site. Open the HTTPS site instead, or on Android forward the port
          with <code>adb reverse</code> and use localhost.
        </p>
        <div class="row">
          <button class="primary" id="b-run">Run bench (<span id="b-count"></span> orders)</button>
          <button id="b-clear" title="Delete the cached model and reload, to measure a first visit">Clear model cache</button>
        </div>
        <div class="bar"><i id="b-bar"></i></div>
        <p id="b-status" class="muted">First run downloads {mb} MB. Use Wi-Fi, keep this tab open and the screen on.</p>
        <p id="b-load" class="muted"></p>
        <pre id="b-ticket" aria-live="off"></pre>
      </div>

      <div class="card" id="b-result" hidden>
        <p class="muted" id="r-dev"></p>
        <div class="grid">
          <div class="stat"><b id="r-median"></b><span>median, submit to ticket</span></div>
          <div class="stat"><b id="r-p90"></b><span>p90</span></div>
          <div class="stat"><b id="r-100"></b><span>orders under 0.1 s</span></div>
          <div class="stat"><b id="r-1s"></b><span>orders under 1 s</span></div>
          <div class="stat"><b id="r-load"></b><span>first load</span></div>
          <div class="stat"><b id="r-ttft"></b><span>median first token</span></div>
        </div>
        <p class="muted" id="r-acc" style="margin-top:10px"></p>
        <p class="warn" id="b-warn" hidden>The tab was hidden during the run, so times may be too slow. Run again with the tab in front.</p>
        <div class="row">
          <button class="primary" id="b-json">Download JSON</button>
          <button id="b-csv">Download CSV</button>
          <button id="b-copy">Copy JSON</button>
        </div>
      </div>

      <footer>
        Test orders: {bench.attribution}, licensed {bench.licence}; a seeded sample
        (seed {bench.seed}) of {bench.orders.length} of {bench.of} test orders, used
        for research only. Model: <a href={model.page}>{model.run_id}</a>, {model.licence}.
      </footer>
    </main>
    <script>
      import "../scripts/bench";
    </script>
  </body>
</html>
